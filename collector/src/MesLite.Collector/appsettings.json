{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Opc.Ua": "Warning",
      "Opc.Ua.Client.ManagedSession": "Information"
    }
  },
  "Collector": {
    "ProductionInterval": "00:00:10",
    "OutboxPath": "outbox.db",
    "StateSettleTime": "00:00:01",
    "Mqtt": {
      "Host": "localhost",
      "Port": 1883,
      "ClientId": "mes-lite-collector",
      "RetryDelay": "00:00:01"
    },
    "Opc": {
      "EndpointUrl": "opc.tcp://localhost:4840/mes-lite/",
      "NamespaceUri": "urn:mes-lite:simulator",
      "SamplingInterval": "00:00:00.250",
      "PublishingInterval": "00:00:01",
      "QueueSize": 10,
      "KeepAliveCount": 10,
      "LifetimeCount": 60,
      "ReconnectInitialDelay": "00:00:01",
      "ReconnectMaxDelay": "00:00:30"
    },
    "Tags": {
      "Running": "{line}.{machine}.Running",
      "FaultCode": "{line}.{machine}.FaultCode",
      "GoodCounter": "{line}.{machine}.GoodCounter",
      "ScrapCounter": "{line}.{machine}.ScrapCounter",
      "Mode": "{line}.{machine}.Mode"
    },
    "Machines": [
      { "Line": "ASM", "Machine": "ROBOT-01" },
      { "Line": "ASM", "Machine": "ROBOT-02" },
      { "Line": "PACK", "Machine": "FILLER-01", "CounterMax": 100 }
    ]
  }
}
