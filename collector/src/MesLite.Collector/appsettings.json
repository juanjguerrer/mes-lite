{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Collector": {
    "Opc": {
      "EndpointUrl": "opc.tcp://localhost:4840/mes-lite/",
      "NamespaceUri": "urn:mes-lite:simulator"
    },
    "Tags": {
      "Running": "{line}.{machine}.Running",
      "FaultCode": "{line}.{machine}.FaultCode",
      "GoodCounter": "{line}.{machine}.GoodCounter",
      "ScrapCounter": "{line}.{machine}.ScrapCounter",
      "Mode": "{line}.{machine}.Mode"
    },
    "Machines": [
      { "Line": "ASM", "Machine": "ROBOT-01" },
      { "Line": "ASM", "Machine": "ROBOT-02" },
      { "Line": "PACK", "Machine": "FILLER-01", "CounterMax": 100 }
    ]
  }
}
